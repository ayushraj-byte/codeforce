#include<bits/stdc++.h>
using namespace std;
void solve(){
    int n,k;
    cin>>n>>k;
    vector<int>a(n);
    string pres="No";
    for(int i=0;i<n;i++){
        cin>>a[i];
        if(a[i]==k){
            pres="Yes";
        }
    }
    cout<<pres<<"
";
}
int main(){
    int t;
    cin>>t;
    while(t--){
        solve();
    }
    return 0;
}